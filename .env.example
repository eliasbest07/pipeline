# ── LLM (Anthropic) ────────────────────────────────────────────
# Requerido para agentes de texto (AG-00 a AG-07)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar por defecto para los agentes de texto
# Opciones: claude-opus-4-6 | claude-sonnet-4-6 | claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Media Generation (fal.ai) ───────────────────────────────────
# Requerido para AG-04 (imágenes), video y audio
FAL_KEY=

OPENAI_API_KEY=

GOOGLE_API_KEY=

# ── Video Generation ────────────────────────────────────────────
# VIDEO_PROVIDER: 'fal' (default, uses KLING via fal.ai) | 'veo' (Google Veo 3)
VIDEO_PROVIDER=fal
FAL_VIDEO_IMAGE_MODEL=fal-ai/veo3.1/fast/image-to-video
FAL_VIDEO_TEXT_MODEL=fal-ai/minimax-video/text-to-video

# Veo 3 options (only used when VIDEO_PROVIDER=veo)
VEO_MODEL=veo-3.0-generate-preview  # or veo-3.1-generate-001
VEO_DURATION_SECONDS=8              # 4, 6, or 8
VEO_ASPECT_RATIO=16:9               # 16:9 or 9:16
VEO_INCLUDE_AUDIO=true              # Veo 3 generates native audio

# ── Skills ──────────────────────────────────────────────────────
# SKL-01 Web Search (elige uno)
BRAVE_API_KEY=
SERPER_API_KEY=
# Si ninguno está configurado, usa DuckDuckGo como fallback (sin key)

# ── Servidor ────────────────────────────────────────────────────
PORT=3000
